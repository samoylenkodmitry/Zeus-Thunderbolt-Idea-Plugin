{
    "name": "zeus-thunderbolt",
    "displayName": "Zeus Thunderbolt",
    "description": "Particle effects for typing and cursor movement",
    "version": "1.0.0",
    "publisher": "your-publisher-name",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "configuration": {
            "title": "Zeus Thunderbolt",
            "properties": {
                "zeusThunderbolt.theme": {
                    "type": "string",
                    "default": "None",
                    "enum": [
                        "None",
                        "NorthernLights",
                        "CyberPunk",
                        "DeepOcean",
                        "Spectrum",
                        "LavaFlow",
                        "NeonCity",
                        "Twilight",
                        "VaporWave",
                        "BlackSnow",
                        "Matrix"
                    ],
                    "description": "Select the particle theme"
                },
                "zeusThunderbolt.snowEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable snow effect"
                },
                "zeusThunderbolt.regularParticlesEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable regular particles"
                },
                "zeusThunderbolt.stardustParticlesEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable stardust particles"
                },
                "zeusThunderbolt.reverseParticlesEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable reverse particles on deletion"
                },
                "zeusThunderbolt.butterflyParticlesEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable butterfly particles"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.60.0",
        "@types/node": "^14.17.0",
        "@typescript-eslint/eslint-plugin": "^4.26.0",
        "@typescript-eslint/parser": "^4.26.0",
        "eslint": "^7.27.0",
        "typescript": "^4.3.2"
    }
}
